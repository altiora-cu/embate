# Supabase — proyecto de Embate.
# Copiá este archivo a .env.local y completá con las credenciales de tu proyecto:
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Rol de servicio de Supabase. Solo lo usa el servidor, y solo para resolver la
# dirección de correo de un jugador al mandarle un aviso. NUNCA exponerlo al
# navegador: por eso no lleva el prefijo NEXT_PUBLIC_.
# Sin esta clave la app funciona igual; simplemente no manda correos.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, para los enlaces de los correos. En Vercel se puede
# dejar vacía: se deduce del host del request (útil en las URL de preview).
NEXT_PUBLIC_SITE_URL=

# Resend — notificaciones transaccionales (§13 del paquete de dirección).
# Opcional en desarrollo: sin la clave, los avisos simplemente no se envían.
RESEND_API_KEY=
EMBATE_EMAIL_FROM=Embate <no-reply@tu-dominio.com>
